---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { about, education, languages, certs } = content[lang];
---

<section id="sobre" class="mx-auto max-w-6xl px-4 py-28 sm:px-8 md:py-40">
  <p class="eyebrow" data-reveal>{about.label}</p>
  <div class="mt-8 grid gap-12 md:grid-cols-[1.2fr_1fr] md:gap-20">
    <div>
      <h2 class="font-display text-4xl leading-[1.05] font-semibold tracking-tight text-mist sm:text-5xl md:text-6xl" data-reveal>
        {about.title}
      </h2>
      <div class="mt-10 space-y-5 text-lg leading-relaxed text-sage">
        {about.paragraphs.map((p, i) => <p data-reveal style={`--d:${i * 100}ms`}>{p}</p>)}
      </div>
    </div>

    <dl class="self-end border-t border-forest-700">
      {
        about.facts.map((f, i) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-forest-700 py-5" data-reveal style={`--d:${i * 80}ms`}>
            <dt class="font-mono text-[11px] tracking-[0.2em] text-moss uppercase">{f.k}</dt>
            <dd class="text-right font-display text-lg text-mist">{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Formação · Idiomas · Certificações -->
  <div class="mt-24 grid gap-6 md:grid-cols-3">
    <article class="rounded-2xl border border-forest-700 bg-forest-850 p-7" data-reveal>
      <p class="eyebrow">{education.label}</p>
      <h3 class="mt-6 font-display text-2xl font-semibold text-mist">{education.course}</h3>
      <p class="mt-2 text-sage">{education.school}</p>
      <p class="mt-6 inline-flex items-center gap-2 font-mono text-xs text-lime">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-lime"></span>
        {education.status}
      </p>
    </article>

    <article class="rounded-2xl border border-forest-700 bg-forest-850 p-7" data-reveal style="--d:100ms">
      <p class="eyebrow">{languages.label}</p>
      <ul class="mt-6 space-y-6">
        {
          languages.items.map((l) => (
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-display text-xl text-mist">{l.name}</span>
                <span class="text-right text-sm text-sage">{l.level}</span>
              </div>
              <div class="mt-3 h-1 rounded-full bg-forest-700">
                <div class="h-1 rounded-full bg-lime" style={`width:${l.value}%`} />
              </div>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="rounded-2xl border border-dashed border-forest-700 p-7" data-reveal style="--d:200ms">
      <p class="eyebrow">{certs.label}</p>
      <p class="mt-6 text-sage">{certs.empty}</p>
    </article>
  </div>
</section>
