---
import Icon from './Icon.astro';
import { content, links, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].contact;
---

<section id="contato" class="relative overflow-hidden px-4 pt-28 pb-10 sm:px-8 md:pt-40">
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow" data-reveal>{t.label}</p>
    <h2 class="mt-6 font-display text-6xl leading-[0.95] font-semibold tracking-tight text-mist sm:text-8xl md:text-[9rem]" data-reveal>
      {t.title}
    </h2>
    <p class="mt-8 max-w-xl text-lg text-sage" data-reveal>{t.text}</p>

    <div class="mt-12 flex flex-col gap-4 sm:flex-row sm:items-center" data-reveal>
      <a
        href={`mailto:${links.email}`}
        class="font-display text-2xl text-lime underline decoration-lime/40 underline-offset-8 hover:decoration-lime sm:text-4xl"
      >
        {links.email}
      </a>
      <button
        id="copy-email"
        type="button"
        data-email={links.email}
        data-copied={t.copied}
        class="w-fit rounded-full border border-forest-700 px-4 py-2 font-mono text-xs text-sage transition-colors hover:border-lime hover:text-lime sm:ml-4"
      >
        {t.copy}
      </button>
    </div>

    <div class="mt-14 flex flex-wrap gap-3" data-reveal>
      <a
        href={links.cv[lang]}
        download
        class="inline-flex items-center gap-2 rounded-full bg-lime px-6 py-3 font-medium text-forest-950 transition-transform hover:-translate-y-0.5"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"></path></svg>
        {t.cv}
      </a>
      <a
        href={links.linkedin}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-forest-700 px-6 py-3 text-mist transition-colors hover:border-lime hover:text-lime"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path></svg>
        LinkedIn
      </a>
      <a
        href={links.github}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-forest-700 px-6 py-3 text-mist transition-colors hover:border-lime hover:text-lime"
      >
        <Icon name="GitHub" slug="github" size={18} mono />
        GitHub
      </a>
    </div>

    <footer class="mt-28 flex flex-col justify-between gap-2 border-t border-forest-700 pt-6 font-mono text-[11px] tracking-[0.15em] text-moss uppercase sm:flex-row">
      <span>© {new Date().getFullYear()} Cauã Karach</span>
      <span>{content[lang].footer}</span>
    </footer>
  </div>
</section>

<script>
  const btn = document.getElementById('copy-email') as HTMLButtonElement;
  const original = btn.textContent;
  btn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email!);
      btn.textContent = btn.dataset.copied!;
      setTimeout(() => (btn.textContent = original), 1800);
    } catch {}
  });
</script>
